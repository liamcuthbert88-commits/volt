# Copy this file to .env and fill in your own key. .env is gitignored —
# never commit a real key.

# Required for POST /converse. Without this set, the server still starts
# and serves everything else, but /converse responds 503.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-4-5-20250929 if unset.
ANTHROPIC_MODEL=
